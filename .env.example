# Domain Caddy should obtain a TLS certificate for. Point its A/AAAA record at this server.
# Use "http://localhost" for local testing (plain HTTP, no certificate).
DOMAIN=larp.garden

# Proof-of-work difficulty for Anubis (4 = default, higher = slower for visitors AND bots)
ANUBIS_DIFFICULTY=4

# Optional: shown on Anubis error pages
WEBMASTER_EMAIL=
